# OpenJEV API key (https://openjev.sh). Server-side only — never exposed to the browser.
# Leave blank to run with sample decisions (preview mode).
OPENJEV_API_KEY=

# OpenJEV model name.
OPENJEV_MODEL=openjev

# Optional. API root; defaults to https://api.openjev.sh. Only change for testing.
# OPENJEV_BASE_URL=

# OpenAI — optional. Used only for on-demand generation (author-query drafts,
# alt text, rewrite options). Leave blank to hide those features.
OPENAI_API_KEY=
# Model per tier (defaults shown). Cheapest capable tier runs first.
# OPENAI_MODEL_FAST=gpt-5.4-nano
# OPENAI_MODEL_STANDARD=gpt-5.4-mini
# OPENAI_MODEL_FRONTIER=gpt-5.5
# Hard cap on OpenAI requests per hour (per server process).
# OPENAI_MAX_REQUESTS_PER_HOUR=60
# OPENAI_BASE_URL=
