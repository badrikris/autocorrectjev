# TypeSafe AI API key for Jev. Server-side only — never exposed to the browser.
# Leave blank to run with sample decisions (preview mode).
TYPESAFE_API_KEY=

# Jev model name.
JEV_MODEL=jev-latest

# Optional. API root; defaults to https://api.typesafe.ai. Only change for testing.
# TYPESAFE_BASE_URL=
